# Copier en .env et REMPLACER TOUTES LES VALEURS. Ne jamais versionner le fichier .env.
# Générer un secret : python -c "import secrets; print(secrets.token_urlsafe(32))"

ENVIRONNEMENT=developpement

# Mots de passe PostgreSQL (un par rôle)
POSTGRES_MDP_ADMIN=changer-moi-admin
RGPH_API_MDP=changer-moi-api
RGPH_DIRECTUS_MDP=changer-moi-directus

# Clé secrète des empreintes de numéros. NE JAMAIS LA CHANGER en cours d'opération
# (les usagers ne seraient plus reconnus) ; la conserver dans un coffre-fort.
PEPPER_TELEPHONE=changer-moi-au-moins-32-caracteres-aleatoires

# Une clé par canal : canal:cle séparés par des virgules.
# Canaux : ussd, sms, whatsapp, web, kiosque, ambassadeur, centre_ecoute
CLES_API=ussd:changer-cle-ussd,sms:changer-cle-sms,whatsapp:changer-cle-whatsapp,web:changer-cle-web,kiosque:changer-cle-kiosque,ambassadeur:changer-cle-ambassadeur

# Clé du canal centre d'écoute : partagée par l'API et le serveur téléphonique.
CLE_API_CENTRE_ECOUTE=changer-cle-centre

# Clé du Ministère (statistiques, signalements) : 16 caractères au moins.
CLE_MINISTERE=changer-cle-ministere

# Portail web : numéro vert affiché en cas d'escalade. Laisser vide tant qu'il n'est pas attribué.
NUMERO_VERT=
# Adresse(s) IP du proxy HTTPS placé devant l'API (voir README, « Portail web »)
FORWARDED_ALLOW_IPS=127.0.0.1

# Tableau de bord : secret du cookie de session (32 caractères au moins) ;
# SESSION_HTTPS_SEULEMENT=true dès que le site est servi en HTTPS.
SECRET_SESSION=changer-moi-au-moins-32-caracteres-aleatoires-session
SESSION_HTTPS_SEULEMENT=false

# Centre d'appels
# Clé de chiffrement des numéros à rappeler (clé Fernet) :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CLE_CHIFFREMENT=changer-moi-cle-fernet-de-44-caracteres-xxxxxxx=
# Secret dont sont dérivés les mots de passe SIP des postes d'agents.
SECRET_POSTES=changer-moi-au-moins-32-caracteres-aleatoires-postes
NB_POSTES=6
# Touches du choix de la langue au téléphone (doivent correspondre aux messages enregistrés).
SVI_TOUCHES_LANGUES=fr:1,ln:2,sw:3,kg:4,lua:5
# Voix de synthèse française PROVISOIRE quand un contenu n'a pas d'audio (jamais en production).
SVI_SYNTHESE_PROVISOIRE=false
# Délai d'attente avant de proposer un rappel (secondes).
RAPPEL_APRES_SECONDES=180
CONSERVATION_ENREGISTREMENTS_JOURS=90
CONSERVATION_RAPPELS_JOURS=7
# Liaison SIP de l'opérateur (vide tant qu'elle n'est pas fournie).
OPERATEUR_SIP_HOTE=
OPERATEUR_SIP_PORT=5060
OPERATEUR_SIP_UTILISATEUR=
OPERATEUR_SIP_MDP=
OPERATEUR_SIP_ENREGISTREMENT=false
# Adresse IP publique du serveur, annoncée à l'opérateur et aux navigateurs des agents
# (audio). Sur un poste de développement : 127.0.0.1.
SIP_ADRESSE_EXTERNE=
# Adresse WebSocket d'Asterisk pour la console des agents (wss://… derrière le proxy HTTPS).
ASTERISK_WS_URL=ws://localhost:8088/ws
SIP_DOMAINE=rgph2.local
# Tests : téléphone logiciel « simulateur » et appels simulés (jamais en production).
SIMULATEUR_MDP=
TELEPHONIE_SIMULATION=false

# USSD et SMS
# Code court USSD attribué par l'ARPTC (ex. *123#). Vide tant qu'il ne l'est pas.
USSD_CODE=
# Mot de passe du compte d'envoi de Kannel (partagé par l'API et la passerelle SMS).
KANNEL_MDP=changer-moi-kannel
# Nom ou numéro court affiché comme expéditeur (à convenir avec l'opérateur).
SMS_EXPEDITEUR=RGPH2
# Plafond de SMS de réponse par numéro et par jour (chaque SMS coûte).
SMS_REPONSES_PAR_JOUR=10
# Longueur maximale d'une réponse, en SMS (une réponse plus longue est remplacée par sa version courte).
SMS_SEGMENTS_MAX=3
BADGES_VERIFICATIONS_PAR_HEURE=10
# Liaison SMPP de l'opérateur (vide tant qu'elle n'est pas fournie).
OPERATEUR_SMPP_HOTE=
OPERATEUR_SMPP_PORT=2775
OPERATEUR_SMPP_UTILISATEUR=
OPERATEUR_SMPP_MDP=
OPERATEUR_SMPP_SYSTEM_TYPE=
# Tests : opérateur SMS simulé et page /simulateur (jamais en production).
SMS_SIMULATION=false
SIMULATEUR_MOBILE=false

# WhatsApp (API officielle de Meta, « Cloud API ») : voir whatsapp/LISEZMOI.md.
# « simulation » tant que le compte WhatsApp Business de l'INS n'est pas ouvert, puis « meta ».
WHATSAPP_PASSERELLE=simulation
# Identifiant du numéro (« Phone number ID ») et jeton d'accès permanent (utilisateur système).
WHATSAPP_NUMERO_ID=
WHATSAPP_JETON=
# Secret de l'application Meta : sans lui, toute notification est refusée.
WHATSAPP_SECRET_APP=
# Jeton à saisir chez Meta lors de l'abonnement du webhook (à générer).
WHATSAPP_JETON_VERIFICATION=changer-moi-jeton-verification-whatsapp

# Directus (CMS)
DIRECTUS_KEY=changer-moi
DIRECTUS_SECRET=changer-moi
DIRECTUS_ADMIN_EMAIL=admin@exemple.cd
DIRECTUS_ADMIN_MDP=changer-moi
DIRECTUS_URL_PUBLIQUE=http://localhost:8055
