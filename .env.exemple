# Modèle du fichier .env. Ne pas le recopier à la main : lancer
#     python outils/preparer_env.py
# qui tire au hasard les valeurs « @genere », demande les valeurs « @demander »
# (« @demander=défaut » : valeur proposée) et
# garde celles d'un .env existant. Ne jamais versionner le fichier .env.
#
# Ce fichier ne garde que ce qu'il faut AVANT d'atteindre la base, ou ce que lisent
# d'autres conteneurs (PostgreSQL, Directus, Asterisk, Kannel). Le reste (pepper, clés,
# WhatsApp, numéro vert, code USSD…) est saisi ensuite avec l'assistant, et gardé
# CHIFFRÉ en base :
#     docker compose run --rm migrations python -m coeur.reglages initialiser
# Où obtenir chaque valeur : PREREQUIS.md.

ENVIRONNEMENT=developpement

# Clé qui chiffre les réglages gardés en base (clé Fernet). À ranger dans un coffre-fort,
# À PART des sauvegardes de la base : avec elle, une sauvegarde révèle tous les secrets ;
# sans elle, les réglages en base sont perdus.
CLE_MAITRE=@genere:fernet

# Mots de passe PostgreSQL (un par rôle)
POSTGRES_MDP_ADMIN=@genere
RGPH_API_MDP=@genere
RGPH_DIRECTUS_MDP=@genere

# Une clé par canal : canal:cle séparés par des virgules (lue aussi par Kannel).
CLES_API=@genere:cles_api
# Clé du canal centre d'écoute : partagée par l'API et le serveur téléphonique.
CLE_API_CENTRE_ECOUTE=@genere

# Adresse(s) IP du proxy HTTPS placé devant l'API (voir README, « Portail web »).
FORWARDED_ALLOW_IPS=127.0.0.1
FUSEAU_HORAIRE=Africa/Kinshasa

# Centre d'appels (lu aussi par Asterisk)
# Secret dont sont dérivés les mots de passe SIP des postes d'agents.
SECRET_POSTES=@genere
NB_POSTES=6
# Touches du choix de la langue au téléphone (doivent correspondre aux messages enregistrés).
SVI_TOUCHES_LANGUES=fr:1,ln:2,sw:3,kg:4,lua:5
# Voix de synthèse française PROVISOIRE quand un contenu n'a pas d'audio (jamais en production).
SVI_SYNTHESE_PROVISOIRE=false
# Délai d'attente avant de proposer un rappel (secondes).
RAPPEL_APRES_SECONDES=180
# Liaison SIP de l'opérateur et numéro vert (vides tant qu'ils ne sont pas fournis).
OPERATEUR_SIP_HOTE=@demander
OPERATEUR_SIP_PORT=5060
OPERATEUR_SIP_UTILISATEUR=@demander
OPERATEUR_SIP_MDP=@demander
OPERATEUR_SIP_ENREGISTREMENT=false
# Adresse IP publique du serveur, annoncée à l'opérateur et aux navigateurs des agents
# (audio). Sur un poste de développement : 127.0.0.1.
SIP_ADRESSE_EXTERNE=@demander
# Adresse WebSocket d'Asterisk pour la console des agents (wss://… derrière le proxy HTTPS).
ASTERISK_WS_URL=@demander=ws://localhost:8088/ws
SIP_DOMAINE=rgph2.local
# Tests : téléphone logiciel « simulateur » et appels simulés (jamais en production).
SIMULATEUR_MDP=
TELEPHONIE_SIMULATION=false

# SMS (lu aussi par Kannel)
# Mot de passe du compte d'envoi de Kannel (partagé par l'API et la passerelle SMS).
KANNEL_MDP=@genere
# Liaison SMPP de l'opérateur (vide tant qu'elle n'est pas fournie).
OPERATEUR_SMPP_HOTE=@demander
OPERATEUR_SMPP_PORT=2775
OPERATEUR_SMPP_UTILISATEUR=@demander
OPERATEUR_SMPP_MDP=@demander
OPERATEUR_SMPP_SYSTEM_TYPE=
# Tests : opérateur SMS simulé et page /simulateur (jamais en production).
SMS_SIMULATION=false
SIMULATEUR_MOBILE=false

# Directus (CMS)
DIRECTUS_KEY=@genere
DIRECTUS_SECRET=@genere
DIRECTUS_ADMIN_EMAIL=@demander=admin@exemple.cd
DIRECTUS_ADMIN_MDP=@genere
DIRECTUS_URL_PUBLIQUE=@demander=http://localhost:8055

# Transcription des messages vocaux (service « transcription », voir transcription/LISEZMOI.md)
TRANSCRIPTION_MODELE=facebook/mms-1b-all
TRANSCRIPTION_CODES=fr:fra,ln:lin,sw:swh,kg:kng,lua:lua
